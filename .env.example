# =============================================================================
# VaxEvidence Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Required variables must be set for the app to function in production.
# =============================================================================

# --- Supabase (Required for production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-only fallback for NEXT_PUBLIC_SUPABASE_URL (optional)
# SUPABASE_URL=https://your-project.supabase.co

# --- PubMed API (Optional) ---
# Provides higher rate limits for NCBI E-utilities API
# Get a key at: https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_API_KEY=your-ncbi-api-key-here

# --- Storage (Optional) ---
# Supabase Storage bucket name for dataset uploads (defaults to "datasets")
# NEXT_PUBLIC_SUPABASE_DATASETS_BUCKET=datasets

# --- Debug (Optional) ---
# Endpoint for debug log shipping (development only)
# NEXT_PUBLIC_DEBUG_LOG_ENDPOINT=http://localhost:3001/logs

# --- Security (Optional) ---
# Salt for hashing IPs in waitlist submissions (privacy)
# IP_HASH_SALT=your-random-salt-here

# --- AI Research Assistant (Optional) ---
# AI provider: "google" (default, free tier) or "openai"
# AI_PROVIDER=google

# Google Gemini (default provider — free tier: 15 RPM, 1500 RPD)
# Get a key at: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here
# AI_MODEL=gemini-2.0-flash

# OpenAI (alternative provider)
# Get a key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key-here
# AI_MODEL=gpt-4o
